FROM docker.io/library/python:3.12-slim

WORKDIR /build
COPY requirements.runtime.lock .
RUN pip install --no-cache-dir --requirement requirements.runtime.lock \
    --platform manylinux2014_aarch64 --implementation cp --python-version 3.12 \
    --only-binary=:all: --target /runtime-deps

COPY . .
CMD ["python", "-m", "scripts.package"]
