{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Governed AgentCore Gateway and policy boundary for the broker safety lab.",
  "Parameters": {
    "ResourceNamePrefix": {
      "Type": "String",
      "Default": "agentcorebroker",
      "AllowedPattern": "^[a-z][a-z0-9]{0,23}$",
      "Description": "Short collision-resistant prefix for named resources."
    },
    "ArtifactBucketName": {
      "Type": "String",
      "Description": "Deployment artifact bucket created by the bootstrap stack."
    },
    "ArtifactObjectKey": {
      "Type": "String",
      "Description": "Exact S3 object key for the packaged Lambda zip."
    },
    "RuntimeArtifactObjectKey": {
      "Type": "String",
      "Description": "Exact S3 object key for the packaged AgentCore Runtime zip."
    },
    "PolicyEngineMode": {
      "Type": "String",
      "Default": "LOG_ONLY",
      "AllowedValues": ["LOG_ONLY", "ENFORCE"],
      "Description": "Gateway policy mode, promoted only after shadow verification."
    }
  },
  "Resources": {
    "BrokerPolicyEngine": {
      "Type": "AWS::BedrockAgentCore::PolicyEngine",
      "Properties": {
        "Name": {"Fn::Sub": "${ResourceNamePrefix}policyengine"},
        "Description": "Authorization policies for the broker safety lab Gateway.",
        "Tags": [
          {"Key": "Project", "Value": "agentcore-broker-safety-lab"},
          {"Key": "ManagedBy", "Value": "CloudFormation"}
        ]
      }
    },
    "ExecutionLedger": {
      "Type": "AWS::DynamoDB::Table",
      "DeletionPolicy": "Delete",
      "UpdateReplacePolicy": "Delete",
      "Properties": {
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [
          {"AttributeName": "record_key", "AttributeType": "S"}
        ],
        "KeySchema": [
          {"AttributeName": "record_key", "KeyType": "HASH"}
        ],
        "SSESpecification": {"SSEEnabled": true},
        "Tags": [
          {"Key": "Project", "Value": "agentcore-broker-safety-lab"},
          {"Key": "ManagedBy", "Value": "CloudFormation"}
        ]
      }
    },
    "ToolLambdaLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {"Fn::Sub": "/aws/lambda/${ResourceNamePrefix}tooltarget"},
        "RetentionInDays": 14,
        "Tags": [
          {"Key": "Project", "Value": "agentcore-broker-safety-lab"},
          {"Key": "ManagedBy", "Value": "CloudFormation"}
        ]
      }
    },
    "ToolLambdaRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "Description": "Reads and conditionally updates the broker execution ledger.",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {"Service": "lambda.amazonaws.com"},
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "BrokerLedgerAccess",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": ["dynamodb:GetItem", "dynamodb:PutItem", "dynamodb:UpdateItem"],
                  "Resource": {"Fn::GetAtt": ["ExecutionLedger", "Arn"]}
                }
              ]
            }
          },
          {
            "PolicyName": "BrokerTargetLogs",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": ["logs:CreateLogStream", "logs:PutLogEvents"],
                  "Resource": {"Fn::Sub": "${ToolLambdaLogGroup.Arn}:*"}
                }
              ]
            }
          }
        ],
        "Tags": [
          {"Key": "Project", "Value": "agentcore-broker-safety-lab"},
          {"Key": "ManagedBy", "Value": "CloudFormation"}
        ]
      }
    },
    "ToolLambda": {
      "Type": "AWS::Lambda::Function",
      "DependsOn": "ToolLambdaLogGroup",
      "Properties": {
        "FunctionName": {"Fn::Sub": "${ResourceNamePrefix}tooltarget"},
        "Description": "Validated synthetic broker tools for AgentCore Gateway.",
        "Runtime": "python3.12",
        "Handler": "agentcore_broker_safety_lab.lambda_app.handler",
        "Role": {"Fn::GetAtt": ["ToolLambdaRole", "Arn"]},
        "Code": {
          "S3Bucket": {"Ref": "ArtifactBucketName"},
          "S3Key": {"Ref": "ArtifactObjectKey"}
        },
        "Environment": {
          "Variables": {"LEDGER_TABLE_NAME": {"Ref": "ExecutionLedger"}}
        },
        "MemorySize": 128,
        "Timeout": 15,
        "Tags": [
          {"Key": "Project", "Value": "agentcore-broker-safety-lab"},
          {"Key": "ManagedBy", "Value": "CloudFormation"}
        ]
      }
    },
    "GatewayExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "Description": "Allows the AgentCore Gateway to evaluate policy and invoke the broker target.",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {"Service": "bedrock-agentcore.amazonaws.com"},
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {"aws:SourceAccount": {"Ref": "AWS::AccountId"}},
                "ArnLike": {
                  "aws:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:bedrock-agentcore:${AWS::Region}:${AWS::AccountId}:gateway/*"
                  }
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "EvaluateBrokerPolicy",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "bedrock-agentcore:GetPolicyEngine",
                    "bedrock-agentcore:AuthorizeAction",
                    "bedrock-agentcore:PartiallyAuthorizeActions"
                  ],
                  "Resource": [
                    {"Fn::GetAtt": ["BrokerPolicyEngine", "PolicyEngineArn"]},
                    {"Fn::Sub": "arn:${AWS::Partition}:bedrock-agentcore:${AWS::Region}:${AWS::AccountId}:gateway/${ResourceNamePrefix}gateway-*"}
                  ]
                }
              ]
            }
          },
          {
            "PolicyName": "InvokeBrokerToolTarget",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "lambda:InvokeFunction",
                  "Resource": {"Fn::GetAtt": ["ToolLambda", "Arn"]}
                }
              ]
            }
          }
        ],
        "Tags": [
          {"Key": "Project", "Value": "agentcore-broker-safety-lab"},
          {"Key": "ManagedBy", "Value": "CloudFormation"}
        ]
      }
    },
    "BrokerGateway": {
      "Type": "AWS::BedrockAgentCore::Gateway",
      "Properties": {
        "Name": {"Fn::Sub": "${ResourceNamePrefix}gateway"},
        "Description": "IAM-authenticated MCP Gateway for the broker safety lab.",
        "AuthorizerType": "AWS_IAM",
        "ProtocolType": "MCP",
        "ProtocolConfiguration": {
          "Mcp": {"SupportedVersions": ["2025-06-18"]}
        },
        "RoleArn": {"Fn::GetAtt": ["GatewayExecutionRole", "Arn"]},
        "PolicyEngineConfiguration": {
          "Arn": {"Fn::GetAtt": ["BrokerPolicyEngine", "PolicyEngineArn"]},
          "Mode": {"Ref": "PolicyEngineMode"}
        },
        "Tags": {
          "Project": "agentcore-broker-safety-lab",
          "ManagedBy": "CloudFormation"
        }
      }
    },
    "BrokerToolTarget": {
      "Type": "AWS::BedrockAgentCore::GatewayTarget",
      "Properties": {
        "GatewayIdentifier": {"Ref": "BrokerGateway"},
        "Name": "BrokerTools",
        "Description": "Three bounded synthetic operations tools.",
        "CredentialProviderConfigurations": [
          {"CredentialProviderType": "GATEWAY_IAM_ROLE"}
        ],
        "TargetConfiguration": {
          "Mcp": {
            "Lambda": {
              "LambdaArn": {"Fn::GetAtt": ["ToolLambda", "Arn"]},
              "ToolSchema": {
                "InlinePayload": [
                  {
                    "Name": "get_runbook_procedure",
                    "Description": "Return the applicable synthetic procedure for one service alarm.",
                    "InputSchema": {
                      "Type": "object",
                      "Properties": {
                        "task_id": {"Type": "string"},
                        "service_id": {"Type": "string"},
                        "alarm_code": {"Type": "string"}
                      },
                      "Required": ["task_id", "service_id", "alarm_code"]
                    },
                    "OutputSchema": {
                      "Type": "object",
                      "Properties": {
                        "runbook_id": {"Type": "string"},
                        "procedure": {"Type": "string"},
                        "allowed_action": {"Type": "string"},
                        "source_digest": {"Type": "string"}
                      },
                      "Required": ["runbook_id", "procedure", "allowed_action", "source_digest"]
                    }
                  },
                  {
                    "Name": "inspect_service",
                    "Description": "Return deterministic synthetic health and alarm state for one service.",
                    "InputSchema": {
                      "Type": "object",
                      "Properties": {
                        "task_id": {"Type": "string"},
                        "service_id": {"Type": "string"},
                        "environment": {"Type": "string"}
                      },
                      "Required": ["task_id", "service_id", "environment"]
                    },
                    "OutputSchema": {
                      "Type": "object",
                      "Properties": {
                        "service_id": {"Type": "string"},
                        "environment": {"Type": "string"},
                        "health": {"Type": "string"},
                        "active_alarm": {"Type": "string"}
                      },
                      "Required": ["service_id", "environment", "health", "active_alarm"]
                    }
                  },
                  {
                    "Name": "execute_remediation",
                    "Description": "Execute one approved synthetic remediation with a stable idempotency key.",
                    "InputSchema": {
                      "Type": "object",
                      "Properties": {
                        "task_id": {"Type": "string"},
                        "service_id": {"Type": "string"},
                        "environment": {"Type": "string"},
                        "action": {"Type": "string"},
                        "idempotency_key": {"Type": "string"}
                      },
                      "Required": ["task_id", "service_id", "environment", "action", "idempotency_key"]
                    },
                    "OutputSchema": {
                      "Type": "object",
                      "Properties": {
                        "status": {"Type": "string"},
                        "approval_request_id": {"Type": "string"},
                        "execution_id": {"Type": "string"},
                        "effect_count": {"Type": "integer"}
                      },
                      "Required": ["status"]
                    }
                  }
                ]
              }
            }
          }
        }
      }
    },
    "BrokerOperatorRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "Description": "Approves exact pending requests and invokes the bounded broker Gateway.",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "AWS": {"Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:root"}
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "OperateBoundedBroker",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "bedrock-agentcore:InvokeGateway",
                  "Resource": {"Fn::GetAtt": ["BrokerGateway", "GatewayArn"]}
                },
                {
                  "Effect": "Allow",
                  "Action": ["dynamodb:GetItem", "dynamodb:UpdateItem"],
                  "Resource": {"Fn::GetAtt": ["ExecutionLedger", "Arn"]}
                }
              ]
            }
          }
        ],
        "Tags": [
          {"Key": "Project", "Value": "agentcore-broker-safety-lab"},
          {"Key": "ManagedBy", "Value": "CloudFormation"}
        ]
      }
    },
    "BrokerRuntimeRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "Description": "Allows the proposal-only runtime to read the Gateway and invoke Nova Micro.",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {"Service": "bedrock-agentcore.amazonaws.com"},
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {"aws:SourceAccount": {"Ref": "AWS::AccountId"}},
                "ArnLike": {
                  "aws:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:bedrock-agentcore:${AWS::Region}:${AWS::AccountId}:runtime/*"
                  }
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "InvokeBoundedBrokerDependencies",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": ["bedrock:InvokeModel", "bedrock:InvokeModelWithResponseStream"],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:bedrock:${AWS::Region}::foundation-model/amazon.nova-micro-v1:0"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "bedrock-agentcore:InvokeGateway",
                  "Resource": {"Fn::GetAtt": ["BrokerGateway", "GatewayArn"]}
                },
                {
                  "Effect": "Allow",
                  "Action": "s3:GetObject",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::${ArtifactBucketName}/${RuntimeArtifactObjectKey}"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": ["logs:CreateLogGroup", "logs:DescribeLogStreams"],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/bedrock-agentcore/runtimes/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": ["logs:CreateLogStream", "logs:PutLogEvents"],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/bedrock-agentcore/runtimes/*:log-stream:*"
                  }
                }
              ]
            }
          }
        ],
        "Tags": [
          {"Key": "Project", "Value": "agentcore-broker-safety-lab"},
          {"Key": "ManagedBy", "Value": "CloudFormation"}
        ]
      }
    },
    "BrokerRuntime": {
      "Type": "AWS::BedrockAgentCore::Runtime",
      "DependsOn": ["GetRunbookPolicy", "InspectServicePolicy"],
      "Properties": {
        "AgentRuntimeName": {"Fn::Sub": "${ResourceNamePrefix}_runtime"},
        "Description": "Bounded read-then-propose broker using Nova Micro.",
        "AgentRuntimeArtifact": {
          "CodeConfiguration": {
            "Code": {
              "S3": {
                "Bucket": {"Ref": "ArtifactBucketName"},
                "Prefix": {"Ref": "RuntimeArtifactObjectKey"}
              }
            },
            "EntryPoint": ["agentcore_broker_safety_lab/runtime_app.py"],
            "Runtime": "PYTHON_3_12"
          }
        },
        "EnvironmentVariables": {
          "GATEWAY_URL": {"Fn::GetAtt": ["BrokerGateway", "GatewayUrl"]}
        },
        "LifecycleConfiguration": {
          "IdleRuntimeSessionTimeout": 300,
          "MaxLifetime": 900
        },
        "NetworkConfiguration": {"NetworkMode": "PUBLIC"},
        "ProtocolConfiguration": "HTTP",
        "RoleArn": {"Fn::GetAtt": ["BrokerRuntimeRole", "Arn"]},
        "Tags": {
          "Project": "agentcore-broker-safety-lab",
          "ManagedBy": "CloudFormation"
        }
      }
    },
    "GetRunbookPolicy": {
      "Type": "AWS::BedrockAgentCore::Policy",
      "DependsOn": "BrokerToolTarget",
      "Properties": {
        "Name": {"Fn::Sub": "${ResourceNamePrefix}getrunbook"},
        "Description": "Allows only the bounded synthetic runbook lookup.",
        "PolicyEngineId": {"Fn::GetAtt": ["BrokerPolicyEngine", "PolicyEngineId"]},
        "EnforcementMode": "ACTIVE",
        "ValidationMode": "FAIL_ON_ANY_FINDINGS",
        "Definition": {
          "Cedar": {
            "Statement": {
              "Fn::Sub": [
                "permit (\n    principal is AgentCore::IamEntity,\n    action == AgentCore::Action::\"BrokerTools___get_runbook_procedure\",\n    resource == AgentCore::Gateway::\"${GatewayArn}\"\n)\nwhen {\n    (principal.id == \"${RuntimePrincipal}\" ||\n     principal.id == \"${OperatorPrincipal}\") &&\n    context.input.service_id == \"claims-api\" &&\n    (context.input.alarm_code == \"HIGH_ERROR_RATE\" ||\n     context.input.alarm_code == \"DATABASE_CORRUPTION\")\n};\n",
                {
                  "GatewayArn": {"Fn::GetAtt": ["BrokerGateway", "GatewayArn"]},
                  "RuntimePrincipal": {"Fn::Sub": "arn:${AWS::Partition}:sts::${AWS::AccountId}:assumed-role/${BrokerRuntimeRole}"},
                  "OperatorPrincipal": {"Fn::Sub": "arn:${AWS::Partition}:sts::${AWS::AccountId}:assumed-role/${BrokerOperatorRole}"}
                }
              ]
            }
          }
        }
      }
    },
    "InspectServicePolicy": {
      "Type": "AWS::BedrockAgentCore::Policy",
      "DependsOn": "BrokerToolTarget",
      "Properties": {
        "Name": {"Fn::Sub": "${ResourceNamePrefix}inspectservice"},
        "Description": "Allows only the bounded synthetic service inspection.",
        "PolicyEngineId": {"Fn::GetAtt": ["BrokerPolicyEngine", "PolicyEngineId"]},
        "EnforcementMode": "ACTIVE",
        "ValidationMode": "FAIL_ON_ANY_FINDINGS",
        "Definition": {
          "Cedar": {
            "Statement": {
              "Fn::Sub": [
                "permit (\n    principal is AgentCore::IamEntity,\n    action == AgentCore::Action::\"BrokerTools___inspect_service\",\n    resource == AgentCore::Gateway::\"${GatewayArn}\"\n)\nwhen {\n    (principal.id == \"${RuntimePrincipal}\" ||\n     principal.id == \"${OperatorPrincipal}\") &&\n    context.input.service_id == \"claims-api\" &&\n    context.input.environment == \"demo\"\n};\n",
                {
                  "GatewayArn": {"Fn::GetAtt": ["BrokerGateway", "GatewayArn"]},
                  "RuntimePrincipal": {"Fn::Sub": "arn:${AWS::Partition}:sts::${AWS::AccountId}:assumed-role/${BrokerRuntimeRole}"},
                  "OperatorPrincipal": {"Fn::Sub": "arn:${AWS::Partition}:sts::${AWS::AccountId}:assumed-role/${BrokerOperatorRole}"}
                }
              ]
            }
          }
        }
      }
    },
    "ExecuteRemediationPolicy": {
      "Type": "AWS::BedrockAgentCore::Policy",
      "DependsOn": "BrokerToolTarget",
      "Properties": {
        "Name": {"Fn::Sub": "${ResourceNamePrefix}remediate"},
        "Description": "Allows only the bounded synthetic remediation class.",
        "PolicyEngineId": {"Fn::GetAtt": ["BrokerPolicyEngine", "PolicyEngineId"]},
        "EnforcementMode": "ACTIVE",
        "ValidationMode": "FAIL_ON_ANY_FINDINGS",
        "Definition": {
          "Cedar": {
            "Statement": {
              "Fn::Sub": [
                "permit (\n    principal is AgentCore::IamEntity,\n    action == AgentCore::Action::\"BrokerTools___execute_remediation\",\n    resource == AgentCore::Gateway::\"${GatewayArn}\"\n)\nwhen {\n    principal.id == \"${OperatorPrincipal}\" &&\n    context.input.service_id == \"claims-api\" &&\n    context.input.environment == \"demo\" &&\n    context.input.action == \"restart_worker_pool\"\n};\n",
                {
                  "GatewayArn": {"Fn::GetAtt": ["BrokerGateway", "GatewayArn"]},
                  "OperatorPrincipal": {"Fn::Sub": "arn:${AWS::Partition}:sts::${AWS::AccountId}:assumed-role/${BrokerOperatorRole}"}
                }
              ]
            }
          }
        }
      }
    },
    "GatewayLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {"Fn::Sub": "/aws/vendedlogs/bedrock-agentcore/gateway/APPLICATION_LOGS/${BrokerGateway}"},
        "RetentionInDays": 14,
        "Tags": [
          {"Key": "Project", "Value": "agentcore-broker-safety-lab"},
          {"Key": "ManagedBy", "Value": "CloudFormation"}
        ]
      }
    },
    "GatewayLogSource": {
      "Type": "AWS::Logs::DeliverySource",
      "Properties": {
        "Name": {"Fn::Sub": "${ResourceNamePrefix}-gateway-source"},
        "LogType": "APPLICATION_LOGS",
        "ResourceArn": {"Fn::GetAtt": ["BrokerGateway", "GatewayArn"]},
        "Tags": [
          {"Key": "Project", "Value": "agentcore-broker-safety-lab"}
        ]
      }
    },
    "GatewayLogDestination": {
      "Type": "AWS::Logs::DeliveryDestination",
      "Properties": {
        "Name": {"Fn::Sub": "${ResourceNamePrefix}-gateway-destination"},
        "DeliveryDestinationType": "CWL",
        "DestinationResourceArn": {"Fn::GetAtt": ["GatewayLogGroup", "Arn"]},
        "OutputFormat": "json",
        "Tags": [
          {"Key": "Project", "Value": "agentcore-broker-safety-lab"}
        ]
      }
    },
    "GatewayLogDelivery": {
      "Type": "AWS::Logs::Delivery",
      "Properties": {
        "DeliverySourceName": {"Ref": "GatewayLogSource"},
        "DeliveryDestinationArn": {"Fn::GetAtt": ["GatewayLogDestination", "Arn"]},
        "Tags": [
          {"Key": "Project", "Value": "agentcore-broker-safety-lab"}
        ]
      }
    }
  },
  "Outputs": {
    "GatewayArn": {"Value": {"Fn::GetAtt": ["BrokerGateway", "GatewayArn"]}},
    "GatewayIdentifier": {"Value": {"Ref": "BrokerGateway"}},
    "GatewayUrl": {"Value": {"Fn::GetAtt": ["BrokerGateway", "GatewayUrl"]}},
    "PolicyEngineArn": {"Value": {"Fn::GetAtt": ["BrokerPolicyEngine", "PolicyEngineArn"]}},
    "PolicyEngineMode": {"Value": {"Ref": "PolicyEngineMode"}},
    "GatewayLogGroupName": {"Value": {"Ref": "GatewayLogGroup"}},
    "ToolLambdaLogGroupName": {"Value": {"Ref": "ToolLambdaLogGroup"}},
    "ToolLambdaName": {"Value": {"Ref": "ToolLambda"}},
    "ExecutionLedgerName": {"Value": {"Ref": "ExecutionLedger"}},
    "RuntimeArn": {"Value": {"Fn::GetAtt": ["BrokerRuntime", "AgentRuntimeArn"]}},
    "RuntimeRoleArn": {"Value": {"Fn::GetAtt": ["BrokerRuntimeRole", "Arn"]}},
    "OperatorRoleArn": {"Value": {"Fn::GetAtt": ["BrokerOperatorRole", "Arn"]}}
  }
}
